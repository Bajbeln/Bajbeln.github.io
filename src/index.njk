<body>
  {% include "settings.html" %}
  <div id="main_page_header">
    {% include "main_page_header.html" %}
  </div>

  <a href="/">
    <img src="/assets/images/logga.webp" width="180" height="200" alt="Spexloggan" class="spex-logo">
  </a>
  <h1><a href="/"> Krischanstaspääxets<br>Sajber-Bajbel</a></h1>

  <div class="main-btn-row">
    <!-- <button class="mainPillButton install-btn" onclick="installApp()" aria-label="Lägg till hemskärm" hidden>Lägg till hemskärm</button> -->
    <button type="button" class="mainPillButton copyButton copy-main" onclick="copyMainLink()" aria-label="Kopiera länk till sida" title="Kopiera länk">Kopiera länk</button>
    <button type="button" class="mainPillButton random" aria-label="Välj en slumpmässig kuplett" title="Välj en slumpmässig kuplett">Räändom</button>
  </div>
  <br>

  {%- for entry in spexlist %}
  <a href="{{ entry.url }}" class="button">{% if entry.italic %}<i>{{ entry.label }}</i>{% else %}{{ entry.label }}{% endif %}</a>
  <br>
{% endfor %}

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var searchForm = document.getElementById('search-form');
    if (searchForm) {
      searchForm.addEventListener('submit', function(event) {
        event.preventDefault();
        const searchTerm = document.getElementById('search-input').value.trim().toLowerCase();
        if (!searchTerm) {
          alert("Please enter a search term.");
          return;
        }
        getSongIndex()
          .then(data => {
            const match = data.find(song => song.title.toLowerCase().includes(searchTerm));
            if (match) {
              window.location.href = `${match.page}?search=${encodeURIComponent(searchTerm)}`;
            } else {
              alert("No matching song found.");
            }
          })
          .catch(error => {
            console.error('Error fetching song index:', error);
            alert("Could not load the song index file.");
          });
      });
    }

    var randomBtn = document.querySelector('.random');
    if (randomBtn) {
      randomBtn.addEventListener("click", () => {
        getSongIndex()
          .then(data => {
            const randomSong = data[Math.floor(Math.random() * data.length)];
            window.location.href = `${randomSong.page}?search=${encodeURIComponent(randomSong.title)}`;
          })
          .catch(error => {
            console.error('Error fetching song index:', error);
            alert("Could not load the song index file.");
          });
      });
    }
  });

  function copyMainLink() {
    var btn = document.querySelector('.copy-main');
    btn.style.width = btn.offsetWidth + 'px';
    var url = window.location.href.split("?")[0].split("#")[0];
    var ta = document.createElement("textarea");
    ta.value = url;
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand("copy"); } catch (e) {}
    document.body.removeChild(ta);
    var orig = btn.textContent;
    btn.textContent = "Kopierad!";
    setTimeout(function() { btn.textContent = orig; }, 1500);
  }
</script>

<!-- Footer -->
<div id="footer-container">
  {% include "footer.html" %}
</div>
</body>

</html>
