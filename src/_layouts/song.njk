<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <title>{{ title }} - Bajbeln</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <meta property="og:title" content="{{ title }} - Bajbeln">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://bajbeln.github.io{{ page.url }}">
  <meta property="og:description" content="En kuplett från Bajbeln">
  <meta property="og:image" content="https://bajbeln.github.io/assets/images/og-image.webp">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Bajbeln">
  
  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} - Bajbeln">
  <meta name="twitter:description" content="En kuplett från Bajbeln">
  <meta name="twitter:image" content="https://bajbeln.github.io/assets/images/og-image.webp">
  
  <script>
    (function() {
      try {
        if (localStorage.getItem('darkMode') === 'true') {
          document.documentElement.classList.add('dark-mode');
        }
      } catch(e) {}
    })();
  </script>
  <link rel="stylesheet" href="/style.css">
  {% include "favicons.html" %}
  <script src="/scripts/songIndexCache.js" defer></script>
  <script src="/scripts/settings.js" defer></script>
</head>
<body>
  {% include "settings.html" %}
  <header>
    {% include "spex_page_header.html" %}

    <h2>{{ title }}</h2>
    {%- if singer %}<p><i>({{ singer }})</i></p>{% endif %}
    {%- if melody %}<p><i>Mel. {{ melody }}</i></p>{% endif %}
  </header>

  <main>
    <article class="song-content">
      {{ content | markdownify | safe }}
    </article>
    
    <br><br>
    <nav><a href="/gyttjeblottning/" class="back-link">← Tillbaka till Gyttjeblottning</a></nav>
    <br><br>

    <div id="footer-container">
      {% include "footer.html" %}
    </div>
  </main>
</body>
</html>
