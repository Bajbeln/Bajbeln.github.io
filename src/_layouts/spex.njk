<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <title>{{ tabTitle or title }} - Bajbeln</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Open Graph / Social Media Meta Tags -->
  <meta property="og:title" content="{{ tabTitle or title }} - Bajbeln">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://bajbeln.github.io{{ page.url }}">
  <meta property="og:description" content="Krischanstaspääxets Sajber-Bajbel">
  {%- set ogSpex = spex %}
  {%- if not ogSpex and page.url and page.url != '/' %}
    {%- set urlPath = page.url | replace('/index.html', '') | replace('/', '') %}
    {%- set ogSpex = urlPath %}
  {%- endif %}
  {% if color and ogSpex %}
  <meta property="og:image" content="https://bajbeln.github.io/assets/images/og/og-{{ ogSpex }}.webp">
  {% else %}
  <meta property="og:image" content="https://bajbeln.github.io/assets/images/og-image.webp">
  {% endif %}
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Bajbeln">
  
  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ tabTitle or title }} - Bajbeln">
  <meta name="twitter:description" content="Krischanstaspääxets Sajber-Bajbel">
  {% if color and ogSpex %}
  <meta name="twitter:image" content="https://bajbeln.github.io/assets/images/og/og-{{ ogSpex }}.webp">
  {% else %}
  <meta name="twitter:image" content="https://bajbeln.github.io/assets/images/og-image.webp">
  {% endif %}
  
  <script>
    (function() {
      try {
        if (localStorage.getItem('darkMode') === 'true') {
          document.documentElement.classList.add('dark-mode');
        }
      } catch(e) {
        // localStorage may be unavailable in privacy-restricted browsers.
      }
    })();
  </script>
  <link rel="preload" href="/style.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/style.css"></noscript>
  {% include "favicons.html" %}
  <script src="/scripts/lazy-load-polyfill.js" defer></script>
  <script src="/scripts/lazy-css.js" defer></script>
  <script src="/scripts/songIndexCache.js" defer></script>
  <script src="/scripts/searchscript.js" defer></script>
  <script src="/scripts/pagescript.js" defer></script>
  <script src="/scripts/settings.js" defer></script>
  {%- if color or accentColor or accentBorderColor or darkColor %}<style>
    {% if color %}body { background-color: {{ color }}; }{% endif %}
    {% if accentColor %}.collapsible, .content, button.song-link-btn { background-color: {{ accentColor }}; }{% endif %}
    {% if accentBorderColor %}.collapsible, .content, button.song-link-btn { border-color: {{ accentBorderColor }}; }{% endif %}
    {% if accentColor %}body.dark-mode .collapsible, body.dark-mode .content, body.dark-mode button.song-link-btn { background-color: {{ darkAccentColor or '#2d3a5e' }}; border-color: {{ darkAccentBorderColor or darkAccentColor or '#2d3a5e' }}; }{% endif %}
    {% if darkColor %}body.dark-mode { background-color: {{ darkColor }}; }{% endif %}
  </style>{% endif %}
</head>
<body>
  {% include "settings.html" %}
  <header>
    {% include "spex_page_header.html" %}

    <h2>{{ title }}</h2>
    {%- set _facts = facts or factbox or info %}
    <div class="page-header-actions">
    <button type="button" class="pagePillButton copyButton" onclick="copyLink()" aria-label="Kopiera länk till sida" title="Kopiera länk">Kopiera länk</button>
    <button type="button" class="pagePillButton random-page" onclick="goToRandomSong()" aria-label="Gå till en slumpmässig kuplett" title="Välj en slumpmässig kuplett">Räändom</button>
    <div class="page-header-actions-right">
      <button type="button" class="pageRoundButton toggle-all-btn" id="toggleAllBtn" onclick="toggleAll()" aria-label="Expandera/kollapsa alla kupletter" title="Expandera eller kollapsa alla kupletter">
        <svg class="icon-expand" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polyline points="3,4 10,10 17,4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <polyline points="3,11 10,17 17,11" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <svg class="icon-collapse" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none">
          <polyline points="3,10 10,4 17,10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <polyline points="3,17 10,11 17,17" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      {%- if _facts %}
      <div class="fact-wrapper">
        <button type="button" class="pageRoundButton factButton" onclick="toggleFactBubble(this)" aria-label="Fakta om spexet" aria-expanded="false">
          <img class="icon-lightbulb" src="/assets/images/spex-fact-button.webp" width="27" alt="" loading="lazy">
        </button>
        <div class="fact-bubble">{{ _facts | markdownify | safe }}</div>
      </div>
      {%- endif %}
    </div>
  </div>
  </header>

  <main>
  <br><br>

  {%- if songs %}
    {%- set pageSongs = collections.songs | songsFromList(songs) %}
    {%- for song in pageSongs %}{{ song | renderSong | safe }}{% endfor %}
  {%- elif uppsattning %}
    {%- set _prefix = page.url | replace("/", "") %}
    {%- for u in uppsattning %}
      {%- set _sectionId = u.id | replace(_prefix ~ "-", "") | replace("-", "_") %}
      <br>
      <div class="uppsattning-header">
        <h2 class="uppsattning-heading" id="{{ _sectionId }}">{{ u.label }}</h2>
        <button type="button" class="uppsattning-link-btn" onclick="copyUppLink(this, '{{ _sectionId }}')" aria-label="Kopiera länk till {{ u.label }}" title="Kopiera länk till avdelningen"><img src="/assets/images/song-link-button.webp" class="song-link-icon" alt="Kopiera länk" loading="lazy"></button>
      </div>
      <br>
      {%- set groupSongs = collections.songs | songsForSpex(u.id) %}
      {%- for song in groupSongs %}{{ song | renderSong | safe }}{% endfor %}
      <br>
    {%- endfor %}
  {%- elif spex %}
    {%- set pageSongs = collections.songs | songsForSpex(spex) %}
    {%- for song in pageSongs %}{{ song | renderSong | safe }}{% endfor %}
  {%- else %}
{{ content | safe }}
  {%- endif %}

  </main>

  <script>
    // Collapsible song sections — find .content inside the same .song-block
    var coll = document.getElementsByClassName("collapsible");
    for (var i = 0; i < coll.length; i++) {
      coll[i].addEventListener("click", function () {
        this.classList.toggle("active");
        var block = this.closest(".song-block");
        var contentDiv = block ? block.querySelector(".content") : this.nextElementSibling;
        contentDiv.classList.toggle("open", this.classList.contains("active"));
        updateToggleBtn();
      });
    }

    if (coll.length === 0) {
      var tBtn = document.getElementById("toggleAllBtn");
      if (tBtn) tBtn.style.display = "none";
    }

    function updateToggleBtn() {
      var btn = document.getElementById("toggleAllBtn");
      if (!btn) return;
      var anyOpen = document.querySelector(".song-block .collapsible.active") !== null;
      btn.querySelector(".icon-expand").style.display = anyOpen ? "none" : "";
      btn.querySelector(".icon-collapse").style.display = anyOpen ? "" : "none";
    }

    // Batched read/write toggleAll to prevent forced synchronous layout reflows (Layout Thrashing)
    function toggleAll() {
      var blocks = Array.from(document.querySelectorAll(".song-block"));
      var anyOpen = blocks.some(function (block) {
        var c = block.querySelector(".content");
        return c && c.classList.contains("open");
      });

      if (anyOpen) {
        blocks.forEach(function (block) {
          var c = block.querySelector(".content");
          var btn = block.querySelector(".collapsible");
          if (c && c.classList.contains("open")) {
            c.classList.remove("open");
            if (btn) btn.classList.remove("active");
          }
        });
      } else {
        blocks.forEach(function (block) {
          var c = block.querySelector(".content");
          var btn = block.querySelector(".collapsible");
          if (c && !c.classList.contains("open")) {
            c.classList.add("open");
            if (btn) btn.classList.add("active");
          }
        });
      }
      updateToggleBtn();
    }

    function goToRandomSong() {
      getSongIndex()
        .then(function(data) {
          var randomSong = data[Math.floor(Math.random() * data.length)];
          window.location.href = randomSong.page + '?search=' + encodeURIComponent(randomSong.title);
        })
        .catch(function(error) {
          console.error('Error fetching song index:', error);
          alert("Could not load the song index file.");
        });
    }

    function triggerCopyFeedback(btn) {
      var img = btn.querySelector("img");
      if (img) {
        img.src = "/assets/images/song-link-feedback.webp";
        setTimeout(function() {
          img.src = "/assets/images/song-link-button.webp";
        }, 1500);
      }
    }

    // Copy a direct anchor link to an uppsättning section
    function copyUppLink(btn, id) {
      var url = location.href.split("#")[0] + "#" + id;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url)
          .then(function() { triggerCopyFeedback(btn); })
          .catch(function() { fallbackCopy(url); triggerCopyFeedback(btn); });
      } else {
        fallbackCopy(url);
        triggerCopyFeedback(btn);
      }
    }

    // Copy a direct anchor link to a specific song
    function copySongLink(id) {
      var url = location.href.split("#")[0] + "#" + id;
      var songBtn = document.getElementById(id);
      var linkBtn = songBtn ? songBtn.nextElementSibling : null;

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url)
          .then(function() { if (linkBtn) triggerCopyFeedback(linkBtn); })
          .catch(function() { fallbackCopy(url); if (linkBtn) triggerCopyFeedback(linkBtn); });
      } else {
        fallbackCopy(url);
        if (linkBtn) triggerCopyFeedback(linkBtn);
      }
    }

    // Spex fact bubble
    function toggleFactBubble(btn) {
      var bubble = btn.nextElementSibling;
      var isOpen = bubble.classList.contains("show");
      closeFactBubbles();
      if (!isOpen) {
        bubble.classList.add("show");
        btn.classList.add("active");
        btn.setAttribute("aria-expanded", "true");
      }
    }

    function closeFactBubbles() {
      document.querySelectorAll(".fact-bubble.show").forEach(function (b) {
        b.classList.remove("show");
      });
      document.querySelectorAll("button.factButton.active").forEach(function (b) {
        b.classList.remove("active");
        b.setAttribute("aria-expanded", "false");
      });
    }

    document.addEventListener("click", function (e) {
      if (!e.target.closest(".fact-wrapper")) closeFactBubbles();
    });

    function fallbackCopy(text) {
      var ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand("copy"); } catch (e) {}
      document.body.removeChild(ta);
    }

    // Open and scroll to a song or production section when the page loads with a hash
    document.addEventListener("DOMContentLoaded", function () {
      var hash = location.hash;
      if (hash && hash.length > 1) {
        var el = document.getElementById(hash.slice(1));
        if (!el) return;
        var scrolled = false;
        function scrollToEl() {
          if (scrolled) return;
          scrolled = true;
          el.scrollIntoView({ behavior: "smooth", block: "start" });
        }

        if (el.classList.contains("collapsible")) {
          el.style.backgroundColor = "#ffd54f";
          setTimeout(function () { el.style.backgroundColor = ""; }, 2000);

          var block = el.closest(".song-block");
          var contentDiv = block ? block.querySelector(".content") : el.nextElementSibling;
          el.click();
          if (contentDiv) {
            contentDiv.addEventListener("transitionend", scrollToEl, { once: true });
          }
          setTimeout(scrollToEl, 350);
        } else {
          scrollToEl();
        }
        updateToggleBtn();
      }
    });
  </script>

  <!-- Footer -->
  <div id="footer-container">
    {% include "footer.html" %}
  </div>
</body>

</html>
