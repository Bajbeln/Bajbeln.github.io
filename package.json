{
  "name": "bajbeln",
  "version": "1.0.0",
  "description": "Krischanstaspääxets Sajber-Bajbel",
  "scripts": {
    "build": "eleventy",
    "build:dev": "eleventy --serve --incremental",
    "build:watch": "eleventy --watch --incremental",
    "start": "npm run build:dev",
    "generate:og-images": "bash scripts/generate-og-images.sh",
    "build:all": "npm run generate:og-images && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js,.cjs,.mjs",
    "lint:fix": "eslint . --ext .js,.cjs,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "echo 'TypeScript not yet configured - run npm install typescript @types/node to enable'"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vitest": "^0.3.20",
    "markdown-it": "^14.0.0",
    "node-cache": "^5.1.2",
    "prettier": "^3.2.5",
    "vitest": "^1.0.0"
  }
}
