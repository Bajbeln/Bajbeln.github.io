{
  "name": "bajbeln",
  "version": "1.0.0",
  "type": "module",
  "description": "Krischanstaspääxets Sajber-Bajbel",
  "scripts": {
    "prebuild": "npm run generate:stats && npm run generate:og-images",
    "prestart": "npm run generate:stats && npm run generate:og-images",
    "build": "tsx ./node_modules/.bin/eleventy --config=eleventy.config.ts",
    "build:e2e": "npm run generate:stats && tsx ./node_modules/.bin/eleventy --config=eleventy.config.ts",
    "build:dev": "tsx ./node_modules/.bin/eleventy --config=eleventy.config.ts --serve --incremental",
    "serve:e2e": "python3 -m http.server 4173 --directory _site",
    "build:watch": "tsx ./node_modules/.bin/eleventy --config=eleventy.config.ts --watch --incremental",
    "start": "npm run build:dev",
    "generate:og-images": "bash scripts/generate-og-images.sh",
    "generate:stats": "node scripts/generate-stats.js",
    "build:all": "npm run generate:og-images && npm run generate:stats && npm run build",
    "test": "vitest run && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts",
    "lint:fix": "eslint . --ext .js,.cjs,.mjs,.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vitest": "^0.5.4",
    "markdown-it": "^15.0.3",
    "node-cache": "^5.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
